PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/gameops
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-random-secret-at-least-18-chars
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
GAME_EVENT_SECRET=replace-with-another-secret-at-least-32-characters
NODE_ENV=production

# Optional: isolated sandbox service only. Leave unset on the existing production service.
# DATABASE_SCHEMA=agency_sandbox_v1
AGENCY_SIMULATION_WORKER=false
AGENCY_GAME_KEYS=[]
# Explicit HTTPS origin for the deployment; otherwise RAILWAY_PUBLIC_DOMAIN is used.
# PUBLIC_SITE_URL=https://your-sandbox.up.railway.app
# AGENCY_CHATVICE_ORIGIN=https://chatvice.app
# AGENCY_CHATVICE_MASTER_MERCHANT=verified-master-sop-merchant
# AGENCY_CHATVICE_TENANT_MERCHANTS={"agent-slug":{"staff":"verified-staff-merchant","public":"verified-public-merchant"}}
