PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/gameops
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-random-secret-at-least-18-chars
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
GAME_EVENT_SECRET=replace-with-another-secret-at-least-32-characters
NODE_ENV=production

# Optional private development link. Disabled unless all three values are valid.
# Store only SHA-256 of a random 32-byte base64url key; never commit the raw link.
DEV_ACCESS_ENABLED=false
DEV_ACCESS_KEY_SHA256=
DEV_ACCESS_EXPIRES_AT=

